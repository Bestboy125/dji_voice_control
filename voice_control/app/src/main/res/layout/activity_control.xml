<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/main_title_rl"
        android:layout_width="fill_parent"
        android:layout_height="50dp"
        android:background="@color/black_overlay" >

        <ImageButton
            android:id="@+id/ReturnBtn"
            android:contentDescription="Enter How Much Cookies You Want"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="5dp"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:onClick="onReturn"
            android:scaleType="centerInside"
            android:src="@drawable/selector_back_button" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="350dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_control_recognize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="开始"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_control_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="停止"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_control_lan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="英文"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_control_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="取消"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:layout_marginTop="70dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="模拟未开始"
        android:id="@+id/textview_simulator"/>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="开始虚拟摇杆"
        style="@style/common_button"
        android:id="@+id/btn_enable_virtual_stick"
        android:layout_marginLeft="5dp"
        android:layout_alignTop="@+id/btn_start_simulator"
        android:layout_alignStart="@+id/directionJoystickLeft"
        android:layout_marginTop="0dp" />

    <EditText
        android:id="@+id/cmd_input"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/directionJoystickLeft"
        android:layout_alignStart="@+id/btn_disable_virtual_stick"
        android:layout_marginStart="-6dp"
        android:layout_marginBottom="136dp"
        android:ems="10"
        android:hint="Command Input"
        android:inputType="textPersonName"
        android:text="" />

    <TextView
        android:id="@+id/process_text"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_above="@+id/btn_start_simulator"
        android:layout_marginBottom="158dp"
        android:text="TextView" />

    <Button
        android:id="@+id/sub_lan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@+id/directionJoystickRight"
        android:layout_alignBottom="@+id/cmd_input"
        android:layout_marginEnd="94dp"
        android:layout_marginBottom="0dp"
        android:text="英文" />

    <Button
        android:id="@+id/sub_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@+id/directionJoystickRight"
        android:layout_alignBottom="@+id/cmd_input"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="0dp"
        android:text="Sub" />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="关闭虚拟摇杆"
        style="@style/common_button"
        android:id="@+id/btn_disable_virtual_stick"
        android:layout_below="@+id/btn_enable_virtual_stick"
        android:layout_alignStart="@+id/btn_enable_virtual_stick"
        android:layout_marginLeft="0dp"
        android:layout_alignEnd="@+id/btn_enable_virtual_stick" />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="起飞"
        style="@style/common_button"
        android:id="@+id/btn_take_off"
        android:layout_alignTop="@+id/btn_disable_virtual_stick"
        android:layout_alignStart="@+id/btn_start_simulator"
        android:layout_marginTop="0dp"
        android:layout_alignEnd="@+id/btn_start_simulator" />

    <ToggleButton
        android:id="@+id/btn_start_simulator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Simulator"
        android:textOff="开始模拟"
        android:textOn="停止模拟"
        style="@style/common_button"
        android:layout_below="@+id/textview_simulator"
        android:layout_toEndOf="@+id/btn_enable_virtual_stick"
        android:layout_marginTop="107dp"
        android:layout_marginLeft="10dp" />


    <Button
        android:id="@+id/btn_land"
        style="@style/common_button"
        android:layout_width="125dp"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/btn_take_off"
        android:layout_alignEnd="@+id/directionJoystickRight"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="45dp"
        android:layout_toEndOf="@+id/btn_take_off"
        android:text="着陆" />

    <Button
        android:id="@+id/btn_photo"
        style="@style/common_button"
        android:layout_width="115dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textview_simulator"
        android:layout_marginStart="-168dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="213dp"
        android:layout_toEndOf="@+id/btn_start_simulator"
        android:text="拍照和录像" />

    <Button
        android:id="@+id/btn_to_download"
        style="@style/common_button"
        android:layout_width="131dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textview_simulator"
        android:layout_marginStart="-33dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="213dp"
        android:layout_toEndOf="@+id/btn_start_simulator"
        android:text="下载" />

    <Button
        android:id="@+id/btn_waypoint"
        style="@style/common_button"
        android:layout_width="131dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textview_simulator"
        android:layout_marginStart="15dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="105dp"
        android:layout_toEndOf="@+id/btn_start_simulator"
        android:text="航点" />

    <com.dji.sdk.voice_control.internal.controller.OnScreenJoystick
        android:id="@+id/directionJoystickLeft"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="10dp"
        android:layout_marginLeft="10dp"
        android:background="@mipmap/joystick_bg"/>

    <com.dji.sdk.voice_control.internal.controller.OnScreenJoystick
        android:id="@+id/directionJoystickRight"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="10dp"
        android:layout_marginRight="10dp"
        android:background="@mipmap/joystick_bg"/>
    <view
        android:layout_width="38dp"
        android:layout_height="15dp"
        class="com.dji.sdk.voice_control.internal.controller.voice_control.BatteryView"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/battery_data"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:id="@+id/battery_view" />

    <TextView
        android:text="100%"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="5dp"
        android:id="@+id/battery_data" />

    <TextView
        android:text="D: 0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/Altitude"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="8dp"
        android:id="@+id/Distance" />

    <TextView
        android:text="V.S: 0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/HorizonSpeed"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="8dp"
        android:id="@+id/VerticalSpeed" />

    <TextView
        android:text="H: 0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/battery_view"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="8dp"
        android:id="@+id/Altitude" />

    <TextView
        android:text="H.S: 0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/Distance"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="8dp"
        android:id="@+id/HorizonSpeed" />

    <TextView
        android:id="@+id/ConnectStatusTextView"
        android:layout_width="100dp"
        android:layout_height="35dp"
        android:text="DJI语音控制"
        android:textColor="@android:color/white"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/LogView"
        android:layout_width="397dp"
        android:layout_height="105dp"
        android:layout_above="@+id/directionJoystickLeft"
        android:layout_marginBottom="16dp"
        android:text="TextView"
        android:scrollbars="vertical"
        android:background="#EFEFEF"
        android:padding="10dp"
        android:maxLines="10"
        android:overScrollMode="always"/>


</RelativeLayout>
