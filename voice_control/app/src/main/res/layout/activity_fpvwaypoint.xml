<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/main_title_rl"
        android:layout_width="fill_parent"
        android:layout_height="50dp"
        android:background="@color/black_overlay" >

        <ImageButton
            android:id="@+id/ReturnBtn"
            android:contentDescription="Enter How Much Cookies You Want"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="5dp"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:onClick="onReturn"
            android:scaleType="centerInside"
            android:src="@drawable/selector_back_button" />

        <TextView
            android:id="@+id/ConnectStatusTextView"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:text="DJI语音控制"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

    </RelativeLayout>


    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="50dp" />

    <FrameLayout
        android:id="@+id/fpv_container"
        android:layout_width="match_parent"
        android:layout_height="252dp"
        android:layout_marginTop="70dp">

        <com.amap.api.maps2d.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        </com.amap.api.maps2d.MapView>

        <!-- TextureView -->
        <TextureView
            android:id="@+id/fpv_texture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chatlist"
        android:layout_width="match_parent"
        android:layout_height="356dp"
        android:layout_marginTop="320dp" />

    <view
        android:layout_width="38dp"
        android:layout_height="15dp"
        class="com.dji.sdk.voice_control.internal.controller.voice_control.BatteryView"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/battery_data"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:id="@+id/battery_view" />

    <TextView
        android:text="100%"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="5dp"
        android:id="@+id/battery_data" />

    <TextView
        android:text="D: 0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/Altitude"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="8dp"
        android:id="@+id/Distance" />

    <TextView
        android:text="V.S: 0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/HorizonSpeed"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="8dp"
        android:id="@+id/VerticalSpeed" />

    <TextView
        android:text="H: 0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/battery_view"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="8dp"
        android:id="@+id/Altitude" />

    <TextView
        android:text="H.S: 0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/Distance"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="8dp"
        android:id="@+id/HorizonSpeed" />

    <RelativeLayout
        android:id="@+id/rl_send"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:padding="1dp">

        <Button
            android:id="@+id/btn_control_recognize"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/icon_record"
            android:text="" />

        <EditText
            android:id="@+id/dialog_Text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_toLeftOf="@+id/help_Btn"
            android:layout_toRightOf="@+id/btn_control_lan"
            android:background="@drawable/bg_rounded_corner"
            android:hint="在这里跟我聊任何内容"
            android:padding="8dp"
            android:textColor="@color/black"
            android:textColorHint="@color/black_65"
            android:textSize="16sp" />

        <Button
            android:id="@+id/send_btn"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_send" />

        <Button
            android:id="@+id/btn_control_lan"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_toRightOf="@+id/btn_control_recognize"
            android:textSize="20sp"
            android:background="@drawable/zh_cn" />

        <!-- 帮助按钮 -->
        <Button
            android:id="@+id/help_Btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_toLeftOf="@+id/send_btn"
            android:layout_marginStart="8dp"
            android:background="@drawable/help" />
    </RelativeLayout>

</RelativeLayout>