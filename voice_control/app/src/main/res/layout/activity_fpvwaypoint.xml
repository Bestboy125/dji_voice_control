<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/view_bg"
    tools:context=".internal.controller.ControlActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/main_title_rl"
            android:layout_width="fill_parent"
            android:layout_height="56dp"
            android:background="@color/colorPrimary"
            android:elevation="4dp">

            <Button
                android:id="@+id/ReturnBtn"
                android:contentDescription="返回按钮"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:adjustViewBounds="true"
                android:background="@drawable/selector_back_button"
                android:onClick="onReturn" />

            <TextView
                android:id="@+id/ConnectStatusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="DJI语音控制"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_open_drawer"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:background="@drawable/round_btn"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="菜单"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

        </RelativeLayout>


        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_below="@+id/main_title_rl"
            android:background="@color/colorPrimary"
            app:tabIndicatorColor="@color/white"
            app:tabSelectedTextColor="@color/white"
            app:tabTextColor="#e0f7fa" />

        <FrameLayout
            android:id="@+id/fpv_container"
            android:layout_width="match_parent"
            android:layout_height="252dp"
            android:layout_below="@+id/tab_layout"
            android:background="#f0f0f0">

            <com.amap.api.maps2d.MapView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- TextureView -->
            <TextureView
                android:id="@+id/fpv_texture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- 状态信息覆盖层 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:orientation="vertical"
                android:background="@drawable/status_overlay_bg"
                android:padding="8dp"
                android:elevation="4dp"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <view
                        android:layout_width="38dp"
                        android:layout_height="15dp"
                        class="com.dji.sdk.voice_control.internal.controller.view.BatteryView"
                        android:id="@+id/battery_view" />

                    <TextView
                        android:id="@+id/battery_data"
                        android:text="100%"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/Altitude"
                    android:text="高度: 0m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    style="@style/flight_data_text" />

                <TextView
                    android:id="@+id/Distance"
                    android:text="距离: 0m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    style="@style/flight_data_text" />

                <TextView
                    android:id="@+id/HorizonSpeed"
                    android:text="水平速度: 0m/s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    style="@style/flight_data_text" />

                <TextView
                    android:id="@+id/VerticalSpeed"
                    android:text="垂直速度: 0m/s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    style="@style/flight_data_text" />

                <TextView
                    android:id="@+id/tv_recording_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="录制中: 00:00"
                    android:textColor="#FF0000"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    style="@style/flight_data_text"
                    android:visibility="gone"/>
            </LinearLayout>
        </FrameLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chatlist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/fpv_container"
            android:layout_above="@+id/rl_send"
            android:padding="8dp"
            android:background="@color/view_bg" />

        <RelativeLayout
            android:id="@+id/rl_send"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_above="@+id/control_buttons_container"
            android:padding="8dp"
            android:background="@color/colorPrimary"
            android:elevation="4dp">

            <Button
                android:id="@+id/btn_control_recognize"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/icon_record"
                android:contentDescription="语音输入" />

            <Button
                android:id="@+id/btn_control_lan"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_toEndOf="@+id/btn_control_recognize"
                android:layout_centerVertical="true"
                android:background="@drawable/zh_cn"
                android:contentDescription="切换语言" />

            <EditText
                android:id="@+id/dialog_Text"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_toEndOf="@+id/btn_control_lan"
                android:layout_toStartOf="@+id/data_Btn"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_rounded_corner"
                android:hint="在这里跟我聊任何内容"
                android:padding="8dp"
                android:textColor="@color/black"
                android:textColorHint="@color/gray"
                android:textSize="14sp" />

            <Button
                android:id="@+id/data_Btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_toStartOf="@+id/help_Btn"
                android:layout_centerVertical="true"
                android:background="@drawable/data"
                android:contentDescription="数据" />

            <Button
                android:id="@+id/help_Btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_toStartOf="@+id/send_btn"
                android:layout_centerVertical="true"
                android:background="@drawable/help"
                android:contentDescription="帮助" />

            <Button
                android:id="@+id/send_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_send"
                android:contentDescription="发送" />
        </RelativeLayout>

        <!-- 控制按钮容器 -->
        <LinearLayout
            android:id="@+id/control_buttons_container"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_above="@+id/joystick_container"
            android:background="@color/colorPrimary"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/problem_buttion"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/round_btn"
                android:text="诊断信息"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_save_chat"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/round_btn"
                android:text="保存"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/Flight_control_tab"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/round_btn"
                android:text="语音控制"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/test"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/round_btn"
                android:text="测试"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 摇杆容器 -->
        <RelativeLayout
            android:id="@+id/joystick_container"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_alignParentBottom="true"
            android:background="@color/view_bg">

            <com.dji.sdk.voice_control.internal.controller.flightcontrol.OnScreenJoystick
                android:id="@+id/directionJoystickLeft"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:background="@mipmap/joystick_bg" />

            <com.dji.sdk.voice_control.internal.controller.flightcontrol.OnScreenJoystick
                android:id="@+id/directionJoystickRight"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:background="@mipmap/joystick_bg" />
        </RelativeLayout>

    </RelativeLayout>

    <!-- 侧边栏 -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/white"
        android:fitsSystemWindows="true">

        <!-- 自定义布局 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="飞行控制"
                    android:textColor="@color/colorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btn_enable_virtual_stick"
                    style="@style/common_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:drawablePadding="8dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:text="开始虚拟摇杆" />

                <Button
                    android:id="@+id/btn_disable_virtual_stick"
                    style="@style/common_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:drawablePadding="8dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:text="关闭虚拟摇杆"/>

                <Button
                    android:id="@+id/btn_waypoint"
                    style="@style/common_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:drawablePadding="8dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:text="航点" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="相机控制"
                    android:textColor="@color/colorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btn_photo"
                    style="@style/common_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:drawablePadding="8dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:text="拍照和录像" />

                <Button
                    android:id="@+id/btn_to_download"
                    style="@style/common_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:drawablePadding="8dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:text="下载" />

                <Button
                    android:id="@+id/btn_record_video"
                    style="@style/common_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:drawablePadding="8dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:text="开始录制" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="高级设置"
                    android:textColor="@color/colorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <ToggleButton
                    android:id="@+id/btn_start_simulator"
                    style="@style/common_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:textOff="开始模拟"
                    android:textOn="停止模拟" />

                <Button
                    android:id="@+id/btn_nogps_takeoff"
                    style="@style/common_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:text="开启无GPS定位起飞" />

                <Button
                    android:id="@+id/set_home_current"
                    style="@style/common_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:text="设置返航点为当前飞机位置" />

                <ToggleButton
                    android:id="@+id/is_GPT_Serve"
                    style="@style/common_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:textOff="使用服务器"
                    android:textOn="使用GPT" />
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>